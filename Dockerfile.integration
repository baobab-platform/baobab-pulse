# syntax=docker/dockerfile:1
# DEV-15 synthetic, disposable *integration-only* Pulse build.
# Do not promote this image to staging/prod; the production Dockerfile is
# authoritative for release. Actual runner must bind an immutable digest.
FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56 AS build
COPY --from=ghcr.io/astral-sh/uv:0.8.17@sha256:e4644cb5bd56fdc2c5ea3ee0525d9d21eed1603bccd6a21f887a938be7e85be1 /uv /uvx /bin/
WORKDIR /app
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/app/.venv
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts ./scripts
COPY migrations ./migrations
COPY tests ./tests
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --group dev \
    && uv pip install --python /app/.venv --reinstall "msgpack==1.2.2" \
    && uv pip uninstall --python /app/.venv setuptools wheel

FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin pulse
WORKDIR /app
COPY --from=build --chown=pulse:pulse /app/.venv /app/.venv
COPY --from=build --chown=pulse:pulse /app/src /app/src
COPY --from=build --chown=pulse:pulse /app/scripts /app/scripts
COPY --from=build --chown=pulse:pulse /app/migrations /app/migrations
COPY --from=build --chown=pulse:pulse /app/tests /app/tests
COPY --chown=pulse:pulse .baobab/development_adapter.py /app/.baobab/development_adapter.py
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BAOBAB_ENVIRONMENT=development
USER pulse
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/readyz',timeout=2)" || exit 1
ENTRYPOINT ["uvicorn","baobab_pulse.api.main:app","--host","0.0.0.0","--port","8000"]
