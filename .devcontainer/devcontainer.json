{
  "name": "Nabhold baobab-pulse",
  "image": "ghcr.io/baobab-platform/baobab-dev:1.4.4",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "postCreateCommand": "baobab-verify --contract && uv sync --all-groups",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "redhat.vscode-yaml",
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.mypy-type-checker"
      ]
    }
  }
}
