# Copy to .env for local development. Names and safe example values only —
# never commit a real .env file or real credentials (item 83).

PULSE_ENVIRONMENT=local
PULSE_LOG_LEVEL=INFO

PULSE_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/baobab_pulse

PULSE_OBJECT_STORAGE_ENDPOINT=
PULSE_OBJECT_STORAGE_BUCKET=baobab-pulse-evidence
PULSE_OBJECT_STORAGE_ACCESS_KEY=
PULSE_OBJECT_STORAGE_SECRET_KEY=

PULSE_OTEL_EXPORTER_OTLP_ENDPOINT=
PULSE_OTEL_TRACES_ENABLED=false

# Optional — only needed once a real (non-mock) Haystack Generator is
# selected. The core test suite and reference pipeline never require these.
PULSE_OPENAI_API_KEY=
PULSE_ANTHROPIC_API_KEY=

# P-CAP-07 production capability authority. In production all of these
# authority endpoints plus the client secret are required; partial
# configuration fails startup. Values below are non-routable examples.
PULSE_IAM_ISSUER_URL=
PULSE_IAM_JWKS_URL=
PULSE_IAM_TOKEN_URL=
PULSE_IAM_CLIENT_ID=baobab-pulse-workload
PULSE_IAM_CLIENT_SECRET=
PULSE_IAM_RESOURCE_AUDIENCE=baobab-pulse
PULSE_IAM_JWT_ALGORITHM=RS256
PULSE_IAM_MAX_TOKEN_LIFETIME_SECONDS=900
PULSE_IAM_CLOCK_SKEW_SECONDS=30
PULSE_CONTROL_PLANE_CONTEXT_VALIDATION_URL=
PULSE_AUTHORITY_HTTP_TIMEOUT_SECONDS=5.0

PULSE_API_HOST=0.0.0.0
PULSE_API_PORT=8000

# Qdrant — semantic-retrieval projection store. PostgreSQL above remains
# canonical; Qdrant is a rebuildable derived index (see ADR-PULSE-011).
# Local dev / docker compose default:
PULSE_QDRANT_URL=http://localhost:6333
# Leave PULSE_QDRANT_URL set and PULSE_QDRANT_LOCATION empty for a real
# server (docker compose / production). Set PULSE_QDRANT_LOCATION=:memory:
# (and leave PULSE_QDRANT_URL empty) to run fully embedded, in-process —
# the default test suite does this; no live Qdrant is required to run it.
PULSE_QDRANT_LOCATION=
PULSE_QDRANT_API_KEY=
PULSE_QDRANT_TLS=false
PULSE_QDRANT_TIMEOUT_SECONDS=5.0
PULSE_QDRANT_COLLECTION_PREFIX=baobab-pulse
PULSE_QDRANT_EVIDENCE_COLLECTION_VERSION=v1

# Embedding profile. "mock" is deterministic and requires no credentials or
# model download — see infrastructure/haystack/embedders/embedding_adapter.py.
PULSE_EMBEDDING_PROVIDER=mock
PULSE_EMBEDDING_MODEL_ID=mock-model
PULSE_EMBEDDING_DIMENSION=768
